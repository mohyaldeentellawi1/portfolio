// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas   = ["SCH_PROJECT" , "SCH_REVIEW", "SCH_MESSAGE", "SCH_SUBSCRIPTION", "SCH_BLOG"]
  
}


enum ProjectType {
  MARKETPLACE
  ECOMMERCE
  BLOG
  COMMUNITY
  PORTFOLIO
  SOCIALMEDIA
  TRADING
  PRODUCTIVITY
  BUSINESS
  UTILITY
  STREAMING
  MEDIA
  

  @@schema("SCH_PROJECT")
}



enum BlogType {
  FRONTEND
  BACKEND
  FLUTTER
  MOBILE
  DEVOPS
  AI
  SOFTWARE_ENGINEERING
  PRODUCT_DEVELOPMENT
  CAREER
  CASE_STUDY
  OTHER
  

  @@schema("SCH_BLOG")
}

enum TechType {
  WEB_FRONTEND
  WEB_BACKEND
  WEB_FULLSTACK
  MOBILE
  TOOL
  OTHER

  @@schema("SCH_PROJECT")
}

enum ProjectMediaType {
  IMAGE
  VIDEO

  @@schema("SCH_PROJECT")
}

enum BlogMediaMode {
  DARK
  LIGHT

  @@schema("SCH_BLOG")
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectTags ProjectTag[]

  
  @@schema("SCH_PROJECT")
}

model Project {
  id            Int      @id @default(autoincrement())
  title         String
  titleEn       String
  description   String
  descriptionEn String
  liveUrl       String?
  githubUrl     String?
  techType      TechType      @default(OTHER)
  projectTypes  ProjectType[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt


  media         ProjectMedia[]
  sections      ProjectSection[]
  tags          ProjectTag[]

  
  @@schema("SCH_PROJECT")
}

model ProjectTag {
  id        Int   @id @default(autoincrement())
  projectId Int
  tagId     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([projectId, tagId])
  @@schema("SCH_PROJECT")
}


model ProjectSection {
  id            Int      @id @default(autoincrement())
  projectId     Int
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  imageRight    Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media         ProjectMedia[]

  @@schema("SCH_PROJECT")
}

model ProjectMedia {
  id           Int   @id @default(autoincrement())
  projectId    Int
  sectionId    Int?
  url          String
  type         ProjectMediaType @default(IMAGE)
  cloudId      String
  fileName     String?
  thumbnailUrl String?
  order        Int      @default(0)
  isMain       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project         @relation(fields: [projectId], references: [id])
  section      ProjectSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@schema("SCH_PROJECT")
}


model ProjectRequest {
  id          Int   @id @default(autoincrement())
  projectType String
  vision      String
  isMvp       Boolean  @default(false)
  budget      String
  timeLine    String
  name        String
  email       String
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  @@schema("SCH_PROJECT")
}

model Review {
  id        Int   @id @default(autoincrement())
  name      String
  nameEn    String?
  content   String
  contentEn String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@schema("SCH_REVIEW")
}


model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("SCH_MESSAGE")
}


model Subscription {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("SCH_SUBSCRIPTION")
}


model BlogPost {
  id          Int      @id @default(autoincrement())
  type        BlogType @default(OTHER)
  title       String
  titleEn     String?
  content     String
  contentEn   String?
  excerpt     String?
  excerptEn   String?
  readingTime Int      @default(0)
  readerCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  media       BlogPostMedia[]

  @@schema("SCH_BLOG")
}


model BlogPostMedia {
  id          Int   @id @default(autoincrement())
  blogPostId  Int
  url         String
  cloudId      String
  mode        BlogMediaMode @default(LIGHT)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blogPost    BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@schema("SCH_BLOG")
}