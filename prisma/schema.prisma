// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas   = ["SCH_PROJECT" , "SCH_REVIEW", "SCH_USER"]
  
}


enum ProjectType {
  MARKETPLACE
  ECOMMERCE
  BLOG
  COMMUNITY
  PORTFOLIO
  SOCIALMEDIA
  TRADING
  PRODUCTIVITY
  BUSINESS
  UTILITY
  STREAMING
  MEDIA
  

  @@schema("SCH_PROJECT")
}

enum TechType {
  WEB_FRONTEND
  WEB_BACKEND
  WEB_FULLSTACK
  MOBILE
  TOOL
  OTHER

  @@schema("SCH_PROJECT")
}

enum ProjectMediaType {
  IMAGE
  VIDEO

  @@schema("SCH_PROJECT")
}



model Tag {
  id        Int      @id @default(autoincrement())
  name      String   
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectTags ProjectTag[]

  
  @@schema("SCH_PROJECT")
}

model Project {
  id            Int      @id @default(autoincrement())
  title         String
  titleEn       String
  description   String
  descriptionEn String
  liveUrl       String?
  githubUrl     String?
  techType      TechType      @default(OTHER)
  projectTypes  ProjectType[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt


  media         ProjectMedia[]
  sections      ProjectSection[]
  tags          ProjectTag[]

  
  @@schema("SCH_PROJECT")
}

model ProjectTag {
  id        Int   @id @default(autoincrement())
  projectId Int
  tagId     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([projectId, tagId])
  @@schema("SCH_PROJECT")
}


model ProjectSection {
  id            Int      @id @default(autoincrement())
  projectId     Int
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  imageRight    Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media         ProjectMedia[]

  @@schema("SCH_PROJECT")
}

model ProjectMedia {
  id           Int   @id @default(autoincrement())
  projectId    Int
  sectionId    Int?
  url          String
  type         ProjectMediaType @default(IMAGE)
  cloudId      String
  fileName     String?
  thumbnailUrl String?
  order        Int      @default(0)
  isMain       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project         @relation(fields: [projectId], references: [id])
  section      ProjectSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@schema("SCH_PROJECT")
}


model Review {
  id        Int   @id @default(autoincrement())
  userId    Int?  @unique
  name      String
  nameEn    String?
  email     String?
  content   String
  contentEn String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id])

  @@schema("SCH_REVIEW")
}


model Subscription {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  userId    Int?     @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id])

  @@schema("SCH_USER")
}



model User {
  id           Int        @id @default(autoincrement())
  googleId     Int?
  firstName    String
  lastName     String?
  email        String        @unique
  password     String
  bio          String?
  imageUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  reviews       Review[]
  subscriptions Subscription[]

  @@schema("SCH_USER")
}

